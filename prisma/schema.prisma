generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @db.Uuid
  displayName String   @map("display_name") @db.VarChar(50)
  bio         String?  @db.Text
  avatarUrl   String?  @map("avatar_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  plays                Play[]
  sentApplications     PerformancePermission[] @relation("Applicant")
  stripeAccount        StripeAccount?
  notifications        Notification[]

  @@map("users")
}

model Play {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId        String    @map("author_id") @db.Uuid
  title           String    @db.VarChar(200)
  synopsis        String    @db.Text
  body            String?   @db.Text
  durationMinutes Int       @map("duration_minutes")
  castTotal       Int       @map("cast_total")
  castMale        Int       @default(0) @map("cast_male")
  castFemale      Int       @default(0) @map("cast_female")
  castOther       Int       @default(0) @map("cast_other")
  feeAmount       Int       @default(0) @map("fee_amount")
  isFree          Boolean   @default(true) @map("is_free")
  isPublished     Boolean   @default(false) @map("is_published")
  viewCount       Int       @default(0) @map("view_count")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  author      User                    @relation(fields: [authorId], references: [id])
  genres      PlayGenre[]
  permissions PerformancePermission[]

  @@index([authorId], map: "idx_play_author")
  @@index([isPublished, publishedAt(sort: Desc)], map: "idx_play_published")
  @@map("plays")
}

model Genre {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(50)
  slug String @unique @db.VarChar(50)

  plays PlayGenre[]

  @@map("genres")
}

model PlayGenre {
  playId  String @map("play_id") @db.Uuid
  genreId Int    @map("genre_id")

  play  Play  @relation(fields: [playId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([playId, genreId])
  @@map("play_genres")
}

model PerformancePermission {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playId             String    @map("play_id") @db.Uuid
  applicantId        String    @map("applicant_id") @db.Uuid
  organizationName   String    @map("organization_name") @db.VarChar(200)
  representativeName String    @map("representative_name") @db.VarChar(100)
  performanceTitle   String    @map("performance_title") @db.VarChar(200)
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime  @map("end_date") @db.Date
  venueName          String    @map("venue_name") @db.VarChar(200)
  venueLocation      String    @map("venue_location") @db.VarChar(300)
  expectedAudience   Int       @map("expected_audience")
  ticketType         String    @map("ticket_type") @db.VarChar(10)
  numPerformances    Int       @default(1) @map("num_performances")
  applicantMessage   String?   @map("applicant_message") @db.Text
  status             String    @default("pending") @db.VarChar(20)
  authorMessage      String?   @map("author_message") @db.Text
  rejectionReason    String?   @map("rejection_reason") @db.Text
  feeAmount          Int       @map("fee_amount")
  platformFee        Int       @default(0) @map("platform_fee")
  permissionNumber   String?   @unique @map("permission_number") @db.VarChar(20)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz
  paidAt             DateTime? @map("paid_at") @db.Timestamptz
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz

  play      Play     @relation(fields: [playId], references: [id])
  applicant User     @relation("Applicant", fields: [applicantId], references: [id])
  payment   Payment?

  @@index([playId], map: "idx_permission_play")
  @@index([applicantId], map: "idx_permission_applicant")
  @@index([status], map: "idx_permission_status")
  @@map("performance_permissions")
}

model Payment {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  permissionId             String    @unique @map("permission_id") @db.Uuid
  stripeCheckoutSessionId  String?   @map("stripe_checkout_session_id") @db.VarChar(200)
  stripePaymentIntentId    String?   @map("stripe_payment_intent_id") @db.VarChar(200)
  amount                   Int
  platformFee              Int       @map("platform_fee")
  authorAmount             Int       @map("author_amount")
  currency                 String    @default("jpy") @db.VarChar(3)
  status                   String    @default("pending") @db.VarChar(20)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt              DateTime? @map("completed_at") @db.Timestamptz

  permission PerformancePermission @relation(fields: [permissionId], references: [id])

  @@map("payments")
}

model StripeAccount {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  stripeAccountId      String   @map("stripe_account_id") @db.VarChar(100)
  onboardingCompleted  Boolean  @default(false) @map("onboarding_completed")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("stripe_accounts")
}

model Notification {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  type         String   @db.VarChar(30)
  permissionId String?  @map("permission_id") @db.Uuid
  title        String   @db.VarChar(200)
  message      String   @db.Text
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt(sort: Desc)], map: "idx_notification_user")
  @@map("notifications")
}
