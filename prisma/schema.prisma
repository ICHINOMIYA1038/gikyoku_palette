generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// 戯曲パレット専用テーブル（palette_ プレフィックス）
// User は戯曲図書館の User テーブルを直接参照
// ============================================

model PalettePlay {
  id              String    @id @default(cuid())
  authorId        String    @map("author_id")
  title           String
  synopsis        String
  body            String?
  bodyPdfUrl      String?   @map("body_pdf_url")
  bodyType        String    @default("text") @map("body_type")
  bodyOrientation String    @default("portrait") @map("body_orientation")
  durationMinutes Int       @map("duration_minutes")
  castTotal       Int       @map("cast_total")
  castMale        Int       @default(0) @map("cast_male")
  castFemale      Int       @default(0) @map("cast_female")
  castOther       Int       @default(0) @map("cast_other")
  feeAmount       Int       @default(0) @map("fee_amount")
  isFree          Boolean   @default(true) @map("is_free")
  isPublished     Boolean   @default(false) @map("is_published")
  coverImageUrl   String?   @map("cover_image_url")
  viewCount       Int       @default(0) @map("view_count")
  downloadCount   Int       @default(0) @map("download_count")
  avgRating       Float     @default(0) @map("avg_rating")
  reviewCount     Int       @default(0) @map("review_count")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  genres      PalettePlayGenre[]
  permissions PalettePermission[]
  reviews     PaletteReview[]

  @@index([authorId], map: "idx_palette_play_author")
  @@index([isPublished, publishedAt(sort: Desc)], map: "idx_palette_play_published")
  @@map("palette_plays")
}

model PaletteGenre {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  plays PalettePlayGenre[]

  @@map("palette_genres")
}

model PalettePlayGenre {
  playId  String @map("play_id")
  genreId Int    @map("genre_id")

  play  PalettePlay  @relation(fields: [playId], references: [id], onDelete: Cascade)
  genre PaletteGenre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([playId, genreId])
  @@map("palette_play_genres")
}

model PalettePermission {
  id                 String    @id @default(cuid())
  playId             String    @map("play_id")
  applicantId        String    @map("applicant_id")
  organizationName   String    @map("organization_name")
  representativeName String    @map("representative_name")
  performanceTitle   String    @map("performance_title")
  startDate          DateTime  @map("start_date")
  endDate            DateTime  @map("end_date")
  venueName          String    @map("venue_name")
  venueLocation      String    @map("venue_location")
  expectedAudience   Int       @map("expected_audience")
  ticketType         String    @map("ticket_type")
  numPerformances    Int       @default(1) @map("num_performances")
  // status: pending | approved | permitted | rejected | revision_requested | withdrawn | expired
  status             String    @default("pending")
  rejectionReason    String?   @map("rejection_reason")
  revisionReason     String?   @map("revision_reason")
  withdrawnAt        DateTime? @map("withdrawn_at")
  withdrawnReason    String?   @map("withdrawn_reason")
  feeAmount          Int       @map("fee_amount")
  platformFee        Int       @default(0) @map("platform_fee")
  permissionNumber   String?   @unique @map("permission_number")
  createdAt          DateTime  @default(now()) @map("created_at")
  reviewedAt         DateTime? @map("reviewed_at")
  paidAt             DateTime? @map("paid_at")
  expiresAt          DateTime? @map("expires_at")

  play        PalettePlay         @relation(fields: [playId], references: [id])
  payment     PalettePayment?
  thread      PaletteThread?
  attachments PaletteAttachment[]

  @@index([playId], map: "idx_palette_permission_play")
  @@index([applicantId], map: "idx_palette_permission_applicant")
  @@index([status], map: "idx_palette_permission_status")
  @@map("palette_permissions")
}

/// スレッド本体。次の2 種類を共存させる。
///   - kind='permission': permissionId が設定されている。1申請=1スレッド。
///   - kind='inquiry'   : permissionId は null、参加者ペアで一意。
/// participant1/participant2 は常に lex order でソートして格納し、
/// inquiry の重複防止 (PARTIAL UNIQUE) と list クエリの高速化に使う。
model PaletteThread {
  id           String   @id @default(cuid())
  permissionId String?  @unique @map("permission_id")
  kind         String   @default("permission")
  participant1 String   @map("participant1")
  participant2 String   @map("participant2")
  lastMessage  String?  @map("last_message")
  lastAt       DateTime @default(now()) @map("last_at")
  createdAt    DateTime @default(now()) @map("created_at")

  permission PalettePermission? @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  messages   PaletteMessage[]

  @@index([lastAt(sort: Desc)], map: "idx_palette_thread_last_at")
  @@index([participant1, lastAt(sort: Desc)], map: "idx_palette_thread_p1")
  @@index([participant2, lastAt(sort: Desc)], map: "idx_palette_thread_p2")
  @@map("palette_threads")
}

/// スレッド内のメッセージ。
/// - type='text'  : ユーザー発話（senderId 必須）
/// - type='system': システムイベント（senderId=null、metadata.kind で種別）
model PaletteMessage {
  id        String    @id @default(cuid())
  threadId  String    @map("thread_id")
  senderId  String?   @map("sender_id")
  type      String    @default("text")
  content   String
  metadata  Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  thread      PaletteThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments PaletteAttachment[]

  @@index([threadId, createdAt], map: "idx_palette_message_thread")
  @@index([senderId, readAt], map: "idx_palette_message_unread")
  @@map("palette_messages")
}

/// 添付ファイル。messageId / permissionId の排他リレーション（アプリ層で担保）。
model PaletteAttachment {
  id           String   @id @default(cuid())
  messageId    String?  @map("message_id")
  permissionId String?  @map("permission_id")
  uploaderId   String   @map("uploader_id")
  fileName     String   @map("file_name")
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type")
  s3Key        String   @map("s3_key")
  createdAt    DateTime @default(now()) @map("created_at")

  message    PaletteMessage?    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  permission PalettePermission? @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([permissionId], map: "idx_palette_attachment_permission")
  @@index([messageId], map: "idx_palette_attachment_message")
  @@map("palette_attachments")
}

model PalettePayment {
  id                       String    @id @default(cuid())
  permissionId             String    @unique @map("permission_id")
  stripeCheckoutSessionId  String?   @map("stripe_checkout_session_id")
  stripePaymentIntentId    String?   @map("stripe_payment_intent_id")
  amount                   Int
  platformFee              Int       @map("platform_fee")
  authorAmount             Int       @map("author_amount")
  currency                 String    @default("jpy")
  status                   String    @default("pending")
  createdAt                DateTime  @default(now()) @map("created_at")
  completedAt              DateTime? @map("completed_at")

  permission PalettePermission @relation(fields: [permissionId], references: [id])

  @@map("palette_payments")
}

model PaletteStripeAccount {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  stripeAccountId      String   @map("stripe_account_id")
  onboardingCompleted  Boolean  @default(false) @map("onboarding_completed")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("palette_stripe_accounts")
}

model PaletteNotification {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  type         String
  permissionId String?  @map("permission_id")
  title        String
  message      String
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt(sort: Desc)], map: "idx_palette_notification_user")
  @@map("palette_notifications")
}

model PaletteReview {
  id        String   @id @default(cuid())
  playId    String   @map("play_id")
  userId    String   @map("user_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  play PalettePlay @relation(fields: [playId], references: [id], onDelete: Cascade)

  @@unique([playId, userId])
  @@index([playId, createdAt(sort: Desc)], map: "idx_palette_review_play")
  @@index([userId], map: "idx_palette_review_user")
  @@map("palette_reviews")
}

